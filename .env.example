# ============================================================================
# AKAMAI SYNTHETIC RELEASE GATE — ENVIRONMENT & AWS DEPLOYMENT CONFIGURATION
# ============================================================================
# Copy to .env (or inject via Terraform / AWS App Runner / ECS task definition).
# When AWS credentials are omitted locally, the portal populates deterministic
# seed data and automatically switches to live AWS Synthetics + Bedrock Nova Lite
# once deployed on AWS.
# ============================================================================

# 1. Server & Control Plane Mode
PORT=3000
NODE_ENV=development
DATA_SOURCE_MODE=template-seed

# 2. Akamai Edge Networks (Staging vs Production DNS / Edge IPs)
DEFAULT_DOMAIN=company.com
AKAMAI_STAGING_EDGE_SUFFIX=.edgekey-staging.net
AKAMAI_STAGING_EDGE_IP=23.56.128.45
AKAMAI_PROD_EDGE_SUFFIX=.edgekey.net
AKAMAI_PROD_EDGE_IP=104.96.22.11
AKAMAI_PRAGMA_HEADERS=akamai-x-cache-on,akamai-x-cache-remote-on,akamai-x-check-cacheable,akamai-x-get-cache-key,akamai-x-get-true-cache-key,akamai-x-get-request-id

# 3. AWS CloudWatch Synthetics, S3 & DynamoDB
AWS_REGION=us-east-1
SYNTHETICS_RUNTIME_VERSION=syn-playwright-chromium-v2.4
SYNTHETICS_S3_BUCKET=akamai-synthetics-gate-prod
SYNTHETICS_DYNAMODB_TABLE=akamai-synthetics-release-gate-runs
SYNTHETICS_IAM_ROLE_ARN=arn:aws:iam::582036321695:role/AkamaiSyntheticsMcpRole

# 4. Amazon Bedrock Visual Judge Model (AWS Nova Lite)
BEDROCK_VISUAL_JUDGE_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_VISUAL_JUDGE_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0

# 5. Model Context Protocol (MCP) & OpenAPI 3.1
MCP_ENDPOINT=mcp://akamai-synthetics-gate/v1
MCP_NPM_PACKAGE=@company/akamai-synthetics-mcp-server
OPENAPI_SPEC_PATH=/api/v1/openapi.json
