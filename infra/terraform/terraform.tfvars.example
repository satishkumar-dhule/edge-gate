# ============================================================================
# EXAMPLE TERRAFORM.TFVARS — AKAMAI SYNTHETIC RELEASE GATE (100% CONFIG-AS-CODE)
# ============================================================================
# Copy to terraform.tfvars to customize any aspect of the deployment, or run
# `terraform apply` directly using the full defaults in variables.tf.
# ============================================================================

# 1. AWS Core & Environment
aws_region             = "us-east-1"
environment            = "prod"
project_name           = "akamai-synthetic-release-gate"
operator_email         = "satishkumardhule@gmail.com"
operator_role          = "Principal Edge SRE"
akamai_account_context = "B-C-1AKAMAI-ENT (Enterprise Production)"

# 2. S3 Artifact Bucket & Lifecycle Retention
s3_artifact_bucket                = "akamai-synthetics-gate-prod"
s3_force_destroy                  = true
artifact_retention_days           = 90
noncurrent_version_retention_days = 30

# 3. DynamoDB & State Seeding
dynamodb_table_name             = "akamai-synthetics-release-gate-runs"
dynamodb_billing_mode           = "PAY_PER_REQUEST"
enable_point_in_time_recovery   = true
seed_accepted_rules_in_dynamodb = true

# 4. SSM Parameter Store & Local .env Generation
ssm_parameter_prefix  = "/akamai-release-gate"
generate_local_dotenv = true

# 5. Amazon Bedrock Nova Lite AI Visual Judge
bedrock_nova_lite_model_id       = "amazon.nova-lite-v1:0"
visual_judge_provider_label      = "Amazon Bedrock (AWS Nova Lite)"
visual_judge_pixel_cost_gate_pct = 0.1
visual_judge_minor_threshold_pct = 5.0
visual_judge_temperature         = 0.0
visual_judge_max_tokens          = 600

# 6. Akamai Staging & Production Edge Networks
default_domain      = "company.com"
staging_edge_suffix = ".edgekey-staging.net"
staging_edge_ip     = "23.56.128.45"
prod_edge_suffix    = ".edgekey.net"
prod_edge_ip        = "104.96.22.11"
canary_user_agent   = "Akamai-Synthetics-Runner/2.4 (ReleaseGate; AWS-CloudWatch-Synthetics)"
restricted_headers  = ["Authorization", "Cookie"]

akamai_pragma_headers = [
  "akamai-x-cache-on",
  "akamai-x-cache-remote-on",
  "akamai-x-check-cacheable",
  "akamai-x-get-cache-key",
  "akamai-x-get-true-cache-key",
  "akamai-x-get-request-id"
]

# 7. Ad-Hoc CloudWatch Synthetics Canary Execution & Viewport ($0/idle Run-Once Mode)
synthetics_runtime_version    = "syn-nodejs-puppeteer-9.1"
start_canaries_on_apply       = false
canary_schedule_expression    = "rate(0 minutes)"
canary_timeout_seconds        = 120
canary_memory_mb              = 2048
canary_active_tracing         = true
canary_success_retention_days = 31
canary_failure_retention_days = 31
viewport_width                = 1440
viewport_height               = 900
navigation_timeout_ms         = 30000

# 8. CloudWatch Logs, Metric Alarms & SNS Alerting
log_retention_days          = 30
alarm_success_threshold_pct = 100
alarm_evaluation_periods    = 1
alarm_notification_email    = ""

# 9. Scale-to-Zero AWS Lambda, API Gateway v2 & MCP ($0.00/hour when idle)
deploy_serverless_lambda             = true
lambda_runtime                       = "nodejs20.x"
lambda_architecture                  = "arm64"
control_plane_lambda_memory_mb       = 512
control_plane_lambda_timeout_seconds = 30
adhoc_runner_lambda_memory_mb        = 1024
adhoc_runner_lambda_timeout_seconds  = 60
enable_lambda_function_url           = true
enable_apigateway_http_api           = true
deploy_cloudfront_distribution       = true
cloudfront_price_class               = "PriceClass_100"
cloudfront_spa_origin_path           = "/portal-ui"
deploy_apprunner_service             = false
ecr_repository_name                  = "akamai-synthetic-release-gate"
container_image_tag                  = "latest"
apprunner_cpu                        = "1024"
apprunner_memory                     = "2048"
apprunner_port                       = "3000"
apprunner_health_check_path          = "/api/v1/health"
mcp_endpoint_uri                     = "mcp://akamai-synthetics-gate/v1"
mcp_npm_package                      = "@company/akamai-synthetics-mcp-server"

initial_operator_users = [
  { email = "sre-lead@company.com", display_name = "Principal Edge SRE", role = "admin" },
  { email = "release-bot@company.com", display_name = "CI/CD Release Automation", role = "operator" },
  { email = "qa-auditor@company.com", display_name = "Edge QA Auditor", role = "viewer" }
]

# 10. Accepted Diff Rules & Baseline Policy
ignore_accepted_diffs = true
accepted_cookies      = []
accepted_visual_tests = []
accepted_diff_rules = [
  {
    id            = "rule-default-x-cache-remote"
    app_id        = "www"
    comparison_id = "all"
    kind          = "x-cache-remote"
    enabled       = true
    note          = "Expected parent tier cache variance between Akamai Staging and Production"
  }
]

# 11. Synthetic Test Suite Checks
test_suite = [
  { id = "T01", name = "Homepage Root & Edge Cache", path = "/", expected_status = "200", critical = true, enabled = true },
  { id = "T02", name = "Product Catalog & Session Cookie", path = "/products", expected_status = "200", critical = true, enabled = true },
  { id = "T03", name = "Enterprise Solutions Hero Layout", path = "/solutions/enterprise", expected_status = "200", critical = true, enabled = true },
  { id = "T04", name = "Global Geo Redirect (/global)", path = "/global", expected_status = "301", critical = true, enabled = true },
  { id = "T05", name = "Authentication Sign-In Portal", path = "/login", expected_status = "200", critical = true, enabled = true },
  { id = "T06", name = "Customer Case Studies Feed", path = "/customers/stories", expected_status = "200", critical = false, enabled = true },
  { id = "T07", name = "Pricing & Tier Calculator", path = "/pricing", expected_status = "200", critical = true, enabled = true },
  { id = "T08", name = "Edge Health Check Probe", path = "/healthz", expected_status = "200", critical = true, enabled = true }
]

# 12. Property & Environment Topology (with Host Maps & Optional Per-Env Edge IP Overrides)
properties = [
  {
    id               = "www"
    name             = "Main Public Portal"
    suite_path       = "config/suites/www.csv"
    default_networks = ["prod", "staging"]
    headers          = { "x-portal-team" = "edge-release-eng" }
    envs = [
      {
        id       = "prod"
        name     = "Production"
        networks = ["prod", "staging"]
        host_map = {
          "www.company.com"    = "www.company.com"
          "assets.company.com" = "assets.company.com"
        }
      },
      {
        id       = "uat"
        name     = "UAT"
        networks = ["prod", "staging"]
        host_map = {
          "www.company.com"    = "uat-www.company.com"
          "assets.company.com" = "uat-assets.company.com"
        }
      }
    ]
  },
  {
    id               = "store"
    name             = "E-Commerce Storefront"
    suite_path       = "config/suites/store.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "Production", networks = ["prod", "staging"], host_map = { "store.company.com" = "store.company.com" } },
      { id = "uat", name = "UAT", networks = ["prod", "staging"], host_map = { "store.company.com" = "uat-store.company.com" } }
    ]
  },
  {
    id               = "help"
    name             = "Help & Docs Center"
    suite_path       = "config/suites/help.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "Production", networks = ["prod", "staging"], host_map = { "help.company.com" = "help.company.com" } }
    ]
  },
  {
    id               = "checkout"
    name             = "Global Checkout & Payments"
    suite_path       = "config/suites/checkout.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "Production", networks = ["prod", "staging"], host_map = { "checkout.company.com" = "checkout.company.com" } },
      { id = "uat", name = "UAT", networks = ["prod", "staging"], host_map = { "checkout.company.com" = "uat-checkout.company.com" } }
    ]
  },
  {
    id               = "api"
    name             = "Edge GraphQL & REST Gateway"
    suite_path       = "config/suites/api.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "Production", networks = ["prod", "staging"], host_map = { "api.company.com" = "api.company.com" } },
      { id = "uat", name = "UAT", networks = ["prod", "staging"], host_map = { "api.company.com" = "uat-api.company.com" } }
    ]
  },
  {
    id               = "auth"
    name             = "Identity & SSO Edge Broker"
    suite_path       = "config/suites/auth.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "Production", networks = ["prod", "staging"], host_map = { "auth.company.com" = "auth.company.com" } },
      { id = "uat", name = "UAT", networks = ["prod", "staging"], host_map = { "auth.company.com" = "uat-auth.company.com" } }
    ]
  },
  {
    id               = "developer"
    name             = "Developer Hub & API Reference"
    suite_path       = "config/suites/developer.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "Production", networks = ["prod", "staging"], host_map = { "developer.company.com" = "developer.company.com" } }
    ]
  },
  {
    id               = "partners"
    name             = "Partner Portal & Rebates"
    suite_path       = "config/suites/partners.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "Production", networks = ["prod", "staging"], host_map = { "partners.company.com" = "partners.company.com" } }
    ]
  }
]
