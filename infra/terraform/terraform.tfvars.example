      { id = "uat", name = "UAT", networks = ["prod", "staging"], host_map = { "help.salesforce.com" = "help-uat.salesforce.com" } }
    ]
  },
  {
    id               = "trailhead"
    name             = "Salesforce Trailhead Learning & Certification (trailhead.salesforce.com)"
    suite_path       = "config/suites/trailhead.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "PROD", networks = ["prod", "staging"], host_map = { "trailhead.salesforce.com" = "trailhead.salesforce.com" } },
      { id = "uat", name = "UAT", networks = ["prod", "staging"], host_map = { "trailhead.salesforce.com" = "trailhead-uat.salesforce.com" } }
    ]
  },
  {
    id               = "status"
    name             = "Salesforce Trust & Real-Time Cloud Status (status.salesforce.com)"
    suite_path       = "config/suites/status.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "PROD", networks = ["prod", "staging"], host_map = { "status.salesforce.com" = "status.salesforce.com" } }
    ]
  },
  {
    id               = "appexchange"
    name             = "Salesforce AppExchange Enterprise Marketplace (appexchange.salesforce.com)"
    suite_path       = "config/suites/appexchange.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "PROD", networks = ["prod", "staging"], host_map = { "appexchange.salesforce.com" = "appexchange.salesforce.com" } },
      { id = "uat", name = "UAT", networks = ["prod", "staging"], host_map = { "appexchange.salesforce.com" = "appexchange-uat.salesforce.com" } }
    ]
  },
  {
    id               = "partners"
    name             = "Salesforce Partner Community & Ecosystem (partners.salesforce.com)"
    suite_path       = "config/suites/partners.csv"
    default_networks = ["prod", "staging"]
    envs = [
      { id = "prod", name = "PROD", networks = ["prod", "staging"], host_map = { "partners.salesforce.com" = "partners.salesforce.com" } },
